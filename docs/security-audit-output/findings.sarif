          }
        },
        {
          "ruleId": "OSG-2026-008",
          "level": "warning",
          "message": {
            "text": "fetch_credit_redemptions() is unreachable dead code in the money module. Grep across app/ and public/ finds no caller. It was written for an admin/support view that was not built."
          },
          "locations": [
            {
